# Copy to .env.local and fill in. Values here are placeholders, never real secrets.

# Public origin of the site. Used as the server-side fallback for the
# sign-in callback (the browser uses its own origin, so production never redirects to localhost).
# Add https://meetin.asia/auth/callback (and your Vercel preview/local URLs) to Supabase >
# Authentication > URL Configuration > Redirect URLs, and set Site URL to https://meetin.asia.
NEXT_PUBLIC_SITE_URL=https://meetin.asia

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@meetin.asia

# Verification and admin
KYC_SIGNING_SECRET=
GEMINI_API_KEY=
# VPN / proxy / Tor / datacenter lookup (lib/safety/vpnCheck.ts). Works without a key at low volume; a key lifts
# the quota. Failures fail open. Set IP_REPUTATION_DISABLED=1 to switch the check off.
IPAPI_IS_KEY=
ADMIN_OWNER_ID=
ADMIN_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
CRON_SECRET=

# CCBill subscriptions (app/api/webhooks/ccbill). The webhook refuses every request until all three are set.
# CCBILL_WEBHOOK_SECRET: long random token, also in the postback URL: /api/webhooks/ccbill?token=<secret>
CCBILL_WEBHOOK_SECRET=
CCBILL_CLIENT_ACCNUM=
CCBILL_CLIENT_SUBACC=

# Plus checkout switch (lib/billing/plusCheckout.ts). Only the exact value "true" opens the buy buttons on /plus and in
# the upgrade sheet; unset or anything else shows "Coming soon" while the pricing, billing terms and legal links stay
# visible. Read at build time: changing it needs a redeploy. Turn it on only after CCBill approves the account and the
# checkout link is wired into app/plus/page.tsx (handleSubscribe) and components/UpgradeModal.tsx (handleCheckout).
NEXT_PUBLIC_PLUS_CHECKOUT_ENABLED=false
