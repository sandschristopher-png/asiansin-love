# Copy to .env.local and fill in. Values here are placeholders, never real secrets.

# Public origin of the site. Used for Stripe return URLs and as the server-side fallback for the
# sign-in callback (the browser uses its own origin, so production never redirects to localhost).
# Add https://meetin.asia/auth/callback (and your Vercel preview/local URLs) to Supabase >
# Authentication > URL Configuration > Redirect URLs, and set Site URL to https://meetin.asia.
NEXT_PUBLIC_SITE_URL=https://meetin.asia

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Plus plans: prices must match lib/plusPlans.ts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_1M=
STRIPE_PLUS_PRICE_3M=
STRIPE_PLUS_PRICE_6M=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@meetin.asia

# Verification and admin
KYC_SIGNING_SECRET=
GEMINI_API_KEY=
IPAPI_IS_KEY=
ADMIN_OWNER_ID=
ADMIN_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
CRON_SECRET=
