<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- AdMob needs its app id here at launch. It comes from the ADMOB_APP_ID gradle property (android/gradle.properties or
             ~/.gradle/gradle.properties); see android/app/build.gradle. PASTE THE PRODUCTION ADMOB APP ID THERE before building
             the release bundle: a release build refuses to run on Google's sample id. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${admobAppId}" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Google / LINE sign-in comes back here: Supabase redirects the system browser to asia.meetin.app://auth/callback,
                 Android reopens the app with that link, and NativeAuthBridge finishes the sign-in. Add the same URL to
                 Supabase > Authentication > URL Configuration > Redirect URLs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="asia.meetin.app" android:host="auth" android:path="/callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera: the four-direction liveness check and profile / Moment photos. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Microphone: voice notes, the voice intro and voice calls (WebRTC). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Approximate location only (city level): confirming the member's city and "use my location" on a Moment. The spot map
         itself never reads the device position, and precise location is not requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Google Play Billing (Plus subscriptions, Boost): @capgo/native-purchases. -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Android 13+ advertising id, required by AdMob. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- None of the hardware is required, so Chromebooks, tablets and phones without a front camera or microphone are not
         excluded from Google Play. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
